# ── Vigilume NVR ─────────────────────────────────────────────
# Copy to .env and fill in. The backend seeds its camera database
# from these on FIRST boot only; after that, manage cameras in the
# web UI (Settings → Cameras).
#
# Tunables use the VIGILUME_* prefix.

TZ=America/New_York

# IANA timezone the backend sets on the Amcrest/Dahua camera clocks. The backend
# pushes this wall-clock time to each camera and DISABLES the camera NTP client
# (NTP + the Dahua timezone index proved unreliable on these units and drift the
# clock hours off). Independent of TZ above; defaults to America/New_York.
CAMERA_TIMEZONE=America/New_York

# Password for the web UI / mobile app
ADMIN_PASSWORD=change-me

# Externally reachable base URL (used in notification click links).
# LAN example:  https://nvr.local:8443   Tailscale example: https://nvr.tailnet-name.ts.net
PUBLIC_URL=

# Host address (LAN IP or hostname) the browser can reach live-view WebRTC on,
# port 8555. Lets live view use fast WebRTC instead of slow MSE without typing
# an IP in the UI. Recommended on the stock Compose deployment, where the
# container can't auto-detect the host LAN IP. Example: 192.168.1.10
# See docs/live-latency.md. Empty = rely on auto-derivation + UI addresses.
VIGILUME_WEBRTC_HOST=

# Optional services, comma-separated:
#   tls    HTTPS terminator (required for PWA install + web push on phones)
#   relay  the APNs push relay (app owner only — see below)
# e.g. COMPOSE_PROFILES=relay
COMPOSE_PROFILES=

# ── APNs push relay (APP OWNER ONLY) ─────────────────────────
# Almost nobody needs this. It holds the iOS app's Apple .p8 signing key and
# forwards E2E-encrypted push to Apple, so ANY Vigilume server can reach the
# app with a real native notification and a CallKit doorbell ring. You only
# run it if you own the app's Apple developer account and are serving other
# people's servers.
#
# If you are a SELF-HOSTER, you do NOT want this: set Settings →
# Notifications → ntfy instead. ntfy needs no Apple account at all. The
# trade-off is real — ntfy alerts land in the ntfy app, so no doorbell ring
# and no native UI — but it costs you nothing to run.
#
# The key goes at ./secrets/apns.p8 (mounted read-only as a DIRECTORY —
# a single-file bind mount fails on Unraid's shfs/FUSE). The relay runs as
# `nobody`, so make it readable by that user:
#   chown nobody:users secrets/apns.p8 && chmod 400 secrets/apns.p8
# deploy.sh excludes secrets/ — the key lives ONLY on the box, and Apple
# lets you download a .p8 exactly once. Back it up somewhere safe.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.vigilume.app

# Which Apple endpoint to use for a push that does NOT name its own
# environment. Each request normally carries one (the origin server knows how
# each device registered), so this is only a fallback for older origin
# servers.
#   sandbox     = builds installed from Xcode
#   production  = TestFlight / App Store
# GET THIS WRONG AND PUSH SILENTLY VANISHES: Apple rejects a sandbox token at
# the production endpoint with BadDeviceToken and the notification is simply
# never delivered. If you are testing with an Xcode build, set sandbox.
APNS_ENV=production

# ── Publishing the relay ─────────────────────────────────────
# Other people's servers can only reach the relay if it has a public HTTPS
# address. It is BUILT to face the internet (see relay/README.md "Why this is
# safe to expose"), so put it behind whatever you already run:
#
#   Cloudflare Tunnel   public hostname -> http://<box-lan-ip>:8090
#   reverse proxy       proxy_pass      -> http://<box-lan-ip>:8090
#
# The relay publishes 8090 on all interfaces for exactly this. A tunnel or
# proxy in a DIFFERENT docker project has its own network and cannot resolve
# `push-relay`, so it needs the box's LAN IP — that is why the port is not
# bound to loopback.
#
# YOUR OWN backend must NOT use the public URL. Set Settings -> Notifications
# -> APNs -> Relay URL to  http://push-relay:8090  so your push never depends
# on the tunnel, DNS, or your internet being up.

# ── Storage ──────────────────────────────────────────────────
# Where 24/7 recordings + event clips are stored (big disk! roughly
# 135 GB/day for the three default cameras). Defaults to ./media
MEDIA_PATH=./media

# ── GPU ──────────────────────────────────────────────────────
# 1 (default): the detector refuses to fall back to CPU when the CUDA
# execution provider is unavailable — health shows detector.ready:false
# with a loud log instead of silently melting a CPU. Set 0 only to
# consciously run detection on CPU (dev machines).
VIGILUME_REQUIRE_GPU=1

# ── Detector backend ─────────────────────────────────────────
# Which inference backend to run:
#   onnx       (default) D-FINE on the GPU (VIGILUME_REQUIRE_GPU applies)
#   onnx_cpu   D-FINE forced onto CPU (overrides VIGILUME_REQUIRE_GPU)
VIGILUME_DETECTOR=onnx

# ── Video transcoding hardware (HEVC cameras) ────────────────
# H.265/HEVC cameras need an HEVC->H.264 transcode for browser playback
# (timeline segments + event clips; recordings on disk stay HEVC). Vigilume
# picks the encoder automatically: NVENC on an NVIDIA box, VAAPI on an
# AMD/Intel iGPU, else libx264 on the CPU.
#
# VAAPI needs the GPU's DRI render node passed into the backend container.
# Run `ls /dev/dri` on the host and set the render node here — this is the
# difference between an iGPU doing the work for free and your CPU doing it:
#     VAAPI_DEVICE=/dev/dri/renderD128
# Leave it unset on an NVIDIA box (NVENC is used) or a box with no GPU.
# VAAPI_DEVICE=/dev/dri/renderD128
#
# Override which node VAAPI runs against if auto-detection picks the wrong
# GPU (rare — only on a box with more than one).
# VIGILUME_VAAPI_DEVICE=/dev/dri/renderD129

# ── Advanced (rarely needed) ─────────────────────────────────
# Where the web container's nginx proxies /go2rtc/ (live-view signaling).
# Leave unset unless you run go2rtc somewhere other than the bundled
# vigilume-go2rtc container. (Named VIGILUME_GO2RTC_UPSTREAM so that a stale
# GO2RTC_UPSTREAM line from a pre-standalone .env, which pointed at the
# external Frigate host, is ignored rather than hijacking the live-view proxy.)
#VIGILUME_GO2RTC_UPSTREAM=http://go2rtc:1984

# ── Cameras (first-boot seeds, optional) ─────────────────────
# name: lowercase letters/digits/underscores only (it becomes the live
#       stream name)
# model: one of IP5M-T1277EW-AI | IP8M-2779EW-AI | AD410
# RTSP credentials = the camera's own user/password (set in the Amcrest
# Smart Home app for the AD410).

CAM1_NAME=front_yard
CAM1_FRIENDLY=Front Yard
CAM1_MODEL=IP5M-T1277EW-AI
CAM1_IP=192.168.1.101
CAM1_USER=admin
CAM1_PASS=

CAM2_NAME=driveway
CAM2_FRIENDLY=Driveway
CAM2_MODEL=IP8M-2779EW-AI
CAM2_IP=192.168.1.102
CAM2_USER=admin
CAM2_PASS=

CAM3_NAME=doorbell
CAM3_FRIENDLY=Front Door
CAM3_MODEL=AD410
CAM3_IP=192.168.1.103
CAM3_USER=admin
CAM3_PASS=

# ── LAN HTTPS (compose profile "tls") ────────────────────────────────────────
# Gives the browser a SECURE CONTEXT on the local network, which is what enables
# the doorbell mic (getUserMedia), PWA install and Web Push. Without it, plain
# http://<lan-ip>:8080 leaves the talk button disabled ("Requires HTTPS").
#
# Fully offline: Caddy is its own CA (`tls internal`) — no internet, no
# Cloudflare, no DNS. Enable with COMPOSE_PROFILES=tls, then:
#   docker compose --profile tls up -d caddy
# and trust Caddy's root CA once per device (see docs/remote-access.md).
#
# Host on the self-signed cert; browse https://<this>:8443. Defaults to the
# box LAN IP if unset — set it to your box's IP, or a single-label mDNS name
# (e.g. nvr.local) your LAN resolves.
TLS_HOSTNAME=192.168.1.253
